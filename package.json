{
  "name": "midgard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living Norse settlement simulation, rendered with ThorVG WebCanvas.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.regression.config.ts",
    "test:roads": "node tests/regression/road-quadrants.browser.mjs",
    "test:loading": "node tests/regression/loading.browser.mjs",
    "test:audio": "node tests/regression/audio-priority.browser.mjs",
    "test:weather-audio": "node tests/regression/weather-speech.browser.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test:lifetime": "node tests/regression/webcanvas-lifetime.browser.mjs",
    "test:editor": "node tests/regression/map-editor-lifecycle.browser.mjs",
    "test:splash": "node tests/regression/splash-runtime.browser.mjs",
    "test:work": "node tests/regression/work-contact.browser.mjs",
    "test:picking": "node tests/regression/picking.browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@thorvg/webcanvas": "1.1.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
