{
  "name": "midgard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living Norse settlement simulation, rendered with ThorVG WebCanvas.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@thorvg/webcanvas": "1.1.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
